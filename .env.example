# ==============================================================================
# CANVA PRO ALGERIA DISTRIBUTION SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Settings
# ------------------------------------------------------------------------------
# Obtain your Bot Token from @BotFather on Telegram (e.g., 123456789:ABCdefGhI...)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your personal Telegram User ID (numeric, e.g., 987654321). 
# Find it via @userinfobot or @raw_data_bot.
ADMIN_ID=123456789

# Mandatory Telegram channel username (must include @) or channel ID (-100...)
# NOTE: The bot MUST be added as an administrator to this channel to verify members.
REQUIRED_CHANNEL=@YourChannelUsername

# Optional direct invite link shown to users (e.g., https://t.me/+AbCdEfGh)
CHANNEL_INVITE_LINK=https://t.me/YourChannelUsername


# ------------------------------------------------------------------------------
# 2. BaridiMob Payment Settings (Track A - 500 DZD)
# ------------------------------------------------------------------------------
# The 20-digit Algerian Postal RIP configured in your BaridiMob account.
TARGET_RIP=00799999000749846290

# Your CCP Account Number (digits only, e.g., 0007498462)
TARGET_CCP=0007498462

# Account Holder full name as displayed in BaridiMob transfer details
ACCOUNT_HOLDER=BEN MOHAMED AHMED

# Payment fee required per Canva seat in Algerian Dinars (default: 500.0 or 700.0)
PAYMENT_AMOUNT=500.0

# Optional comma-separated list of accepted payment amounts in DZD
ACCEPTED_AMOUNTS=500.0,700.0

# Permitted age of the receipt in days: 1 = today and yesterday (recommended), 0 = today only, 2 = up to 2 days ago
DATE_GRACE_DAYS=1


# ------------------------------------------------------------------------------
# 3. Seat Allocation & Referral Policy
# ------------------------------------------------------------------------------
# Total maximum seats in your Canva Pro team allocation
MAX_SEATS=500

# Number of verified channel joins required to unlock a free seat (Track B)
REQUIRED_REFERRALS=5


# ------------------------------------------------------------------------------
# 4. Web Dashboard & Server Configuration
# ------------------------------------------------------------------------------
# Web server bind host and port (Render / Railway automatically overrides PORT)
HOST=0.0.0.0
PORT=8000

# HTTP Basic Auth credentials for the Web Admin Portal (http://your-domain:8000/dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_2026


# ------------------------------------------------------------------------------
# 5. Database & OCR Settings
# ------------------------------------------------------------------------------
# SQLite file storage location (persisted via Docker volumes on VPS)
DATABASE_PATH=canva_system.db

# Path to Tesseract binary (on Linux / Docker leave as 'tesseract')
# On Windows, set e.g.: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
